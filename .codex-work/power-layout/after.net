			(libsource
				(lib "AK4490DAC")
				(part "MCWI03-12D15")
				(description "MinMax MCWI03-12D15: isolated 3W DC-DC, 12V input family (4.5-18V), dual +-15V/100mA output. Reused from the original NEWDAC Eagle design (net \"15V\" fed both this module and the LM1117 regulators). Pinout per MCWI03 datasheet dual-output table: 1=-Vin 2=+Vin 3=Remote On/Off 5=NC 6=+Vout 7=Common 8=-Vout. Footprint: custom AK4490DAC:MCWI03-12D15 (SIP-8 THT, 21.8x9.3mm body, 2.54mm pitch, pin 4 physically absent) - pad size/drill estimated, verify against datasheet mechanical drawing before fab.")
			)
