  (symbol "AK4490DAC:XU316-1024-QF60B-C24" (in_bom yes) (on_board yes)
    (property "Reference" "U" (at 0 86.36 0) (effects (font (size 1.27 1.27))))
    (property "Value" "XU316-1024-QF60B-C24" (at 0 83.82 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "AK4490DAC:XU316_QF60B_7x7" (at 0 0 0) (effects hide (font (size 1.27 1.27))))
    (property "Datasheet" "https://www.xmos.com/download/XU316-1024-QF60B-xcore.ai-Datasheet(3).pdf/" (at 0 0 0) (effects hide (font (size 1.27 1.27))))
    (property "Description" "XMOS xcore.ai USB Audio processor, 60-pin QFN. Replaces PCM2704C+AK4118: USB Audio class device -> I2S output direct to AK4490 (firmware not included, out of scope). GPIO port-to-function assignment (QSPI flash, I2S) is a firmware/software decision - the pin suffixes here (_SS/_SCLK/_IO0 etc, _BICK/_LRCK/_SDATA/_MCLK) are this schematic's chosen assignment, not a fixed hardware pinout. VDD=0.9V core (pins 4,12,19,27,34,42,49,57,61-64), VDDIOB18=1.8V (17,26), VDDIOL/R/T=3.3V (8,38,52), PLL_AVDD=1.8V analog, USB_VDD18/33=USB PHY power, VSS(65)=ground incl. exposed thermal pad." (at 0 0 0) (effects hide (font (size 1.27 1.27))))
